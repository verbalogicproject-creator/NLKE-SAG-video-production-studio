# Local Termux control plane
DATABASE_URL=postgresql://$(id -un)@localhost:5432/verbalogix_chamber
VERBALOGIX_LOCAL_DEV=1
SAG_ENGINE_URL=http://127.0.0.1:8080
SAG_VIDEO_SERVICE_TOKEN=replace-with-a-long-random-local-token

# SAG managed state
SAG_VIDEO_DATABASE_PATH=.sag-video/sag-video.db
SAG_REPOSITORY_BACKEND=sqlite
SAG_STORAGE_BACKEND=filesystem
SAG_VIDEO_STORAGE_ROOT=.sag-video/storage
SAG_VIDEO_STORAGE_CACHE_DIR=.sag-video/cache
SAG_VIDEO_MEDIA_DIR=.sag-video/media
SAG_VIDEO_PROXY_DIR=.sag-video/proxies
SAG_VIDEO_ARTIFACT_DIR=.sag-video/artifacts
SAG_VIDEO_OBSERVER_URL=http://127.0.0.1:8082
SAG_VIDEO_START_ANALYSIS_WORKER=1
# Experimental spatial-computer-use fallbacks remain opt-in. DOM/accessibility
# bindings and semantic handlers are the default path and require neither flag.
SAG_GEMINI_OBSERVER_ENABLED=0
SAG_COORDINATE_FALLBACK_ENABLED=0
# Optional; required only for journal namespaces initialized with hmac-sha256.
SAG_JOURNAL_HMAC_KEY=

# Production GCP adapters
STORAGE_BACKEND=local
QUEUE_BACKEND=local
GOOGLE_CLOUD_PROJECT=
GCP_REGION=us-central1
# `auto` uses the local API key first and falls back to Vertex only on an explicit quota failure.
SAG_GOOGLE_GENAI_BACKEND=auto
GEMINI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_GENAI_LOCATION=global
GCS_MEDIA_BUCKET=
CLOUD_TASKS_QUEUE=
DISPATCH_URL=
TASK_INVOKER_SERVICE_ACCOUNT=
CLOUD_RUN_INTAKE_JOB=
CLOUD_RUN_ANALYSIS_JOB=
CLOUD_RUN_RENDER_JOB=
CLOUD_RUN_OBSERVER_JOB=
CLOUD_RUN_PUBLISH_JOB=
CLOUD_EXECUTION_ENABLED=false
GLOBAL_HEAVY_JOB_LIMIT=2
SAG_DISPATCH_SECRET=replace-with-a-local-dispatch-secret

# Invite-only Google sign-in and private YouTube publishing
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/oauth/youtube/callback
YOUTUBE_KMS_KEY=

# Choose remote transcription or local whisper.cpp
SAG_VIDEO_TRANSCRIPTION_BASE_URL=
SAG_VIDEO_TRANSCRIPTION_API_KEY=
SAG_VIDEO_TRANSCRIPTION_MODEL=whisper-1
SAG_VIDEO_WHISPER_BINARY=whisper-cli
SAG_VIDEO_WHISPER_MODEL=

# Optional editorial ranking
SAG_VIDEO_RANKING_BASE_URL=
SAG_VIDEO_RANKING_API_KEY=
SAG_VIDEO_RANKING_MODEL=
