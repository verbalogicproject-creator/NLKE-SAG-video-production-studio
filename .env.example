# Local Termux control plane
DATABASE_URL=postgresql://localhost:5432/verbalogix_chamber
VERBALOGIX_LOCAL_DEV=1
SAG_ENGINE_URL=http://127.0.0.1:8080
SAG_VIDEO_SERVICE_TOKEN=replace-with-a-long-random-local-token

# SAG managed state
SAG_VIDEO_DATABASE_PATH=.sag-video/sag-video.db
SAG_VIDEO_MEDIA_DIR=.sag-video/media
SAG_VIDEO_PROXY_DIR=.sag-video/proxies
SAG_VIDEO_ARTIFACT_DIR=.sag-video/artifacts
SAG_VIDEO_OBSERVER_URL=http://127.0.0.1:8082
SAG_VIDEO_START_ANALYSIS_WORKER=1

# Choose remote transcription or local whisper.cpp
SAG_VIDEO_TRANSCRIPTION_BASE_URL=
SAG_VIDEO_TRANSCRIPTION_API_KEY=
SAG_VIDEO_TRANSCRIPTION_MODEL=whisper-1
SAG_VIDEO_WHISPER_BINARY=whisper-cli
SAG_VIDEO_WHISPER_MODEL=

# Optional editorial ranking
SAG_VIDEO_RANKING_BASE_URL=
SAG_VIDEO_RANKING_API_KEY=
SAG_VIDEO_RANKING_MODEL=
