FROM python:3.12-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core fonts-noto-core libpq5 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY services/sag-engine/pyproject.toml services/sag-engine/README.md LICENSE ./
COPY services/sag-engine/src ./src
RUN pip install --no-cache-dir .
RUN useradd --create-home --uid 10001 sag && chown -R sag:sag /app
USER sag
ENV PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "uvicorn sag_video.app:app --host 0.0.0.0 --port ${PORT}"]
