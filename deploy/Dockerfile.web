FROM node:22-bookworm-slim AS build
RUN npm install --global pnpm@9.12.0
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/lab-web/package.json apps/lab-web/package.json
COPY packages/lab-sdk/package.json packages/lab-sdk/package.json
COPY packages/media-contracts/package.json packages/media-contracts/package.json
RUN pnpm install --frozen-lockfile
COPY apps/lab-web apps/lab-web
COPY packages packages
COPY prisma prisma
ENV DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build
RUN pnpm db:generate && pnpm --filter @verbalogix/lab-sdk build && pnpm --filter @verbalogix/web build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=8080 HOSTNAME=0.0.0.0
COPY --from=build /app/apps/lab-web/.next/standalone ./
COPY --from=build /app/apps/lab-web/.next/static ./apps/lab-web/.next/static
USER node
EXPOSE 8080
CMD ["node", "apps/lab-web/server.js"]
